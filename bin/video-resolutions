#!/usr/bin/env python3
"""List the coded resolutions of video files in a directory."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


VIDEO_EXTENSIONS = {
    ".3gp",
    ".avi",
    ".flv",
    ".m2ts",
    ".m4v",
    ".mkv",
    ".mov",
    ".mp4",
    ".mpeg",
    ".mpg",
    ".mts",
    ".ts",
    ".webm",
    ".wmv",
}


class ProbeError(Exception):
    """An expected failure while reading a video's resolution."""


@dataclass(frozen=True)
class VideoInfo:
    relative_path: str
    width: int
    height: int

    @property
    def resolution(self) -> str:
        return f"{self.width}x{self.height}"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="video-resolutions",
        description="List video resolutions in a directory.",
    )
    parser.add_argument(
        "directory",
        nargs="?",
        type=Path,
        default=Path("."),
        help="directory to scan (default: current directory)",
    )
    parser.add_argument(
        "--no-recursive",
        action="store_true",
        help="do not scan subdirectories",
    )
    parser.add_argument(
        "--sort-resolution",
        action="store_true",
        help="sort videos by resolution",
    )
    parser.add_argument(
        "--ascending",
        action="store_true",
        help="sort resolution from smallest to largest",
    )
    return parser


def discover_videos(directory: Path, recursive: bool) -> list[tuple[Path, str]]:
    if recursive:
        def raise_scan_error(error: OSError) -> None:
            raise error

        entries = (
            Path(root) / filename
            for root, _, filenames in os.walk(
                directory,
                onerror=raise_scan_error,
                followlinks=False,
            )
            for filename in filenames
        )
    else:
        entries = directory.iterdir()
    videos = [
        (path, str(path.relative_to(directory)))
        for path in entries
        if path.is_file() and path.suffix.casefold() in VIDEO_EXTENSIONS
    ]
    return sorted(videos, key=lambda video: (video[1].casefold(), video[1]))


def probe_video(ffprobe: str, video: Path, relative_path: str) -> VideoInfo:
    try:
        result = subprocess.run(
            [
                ffprobe,
                "-v",
                "error",
                "-select_streams",
                "v:0",
                "-show_entries",
                "stream=width,height",
                "-of",
                "json",
                str(video),
            ],
            text=True,
            encoding="utf-8",
            errors="replace",
            capture_output=True,
            check=False,
        )
    except OSError as error:
        raise ProbeError(f"could not run ffprobe: {error}") from error

    if result.returncode:
        detail = result.stderr.strip() or f"ffprobe exited with status {result.returncode}"
        raise ProbeError(detail)

    try:
        output = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise ProbeError(f"ffprobe returned malformed JSON: {error.msg}") from error

    if not isinstance(output, dict):
        raise ProbeError("ffprobe output does not contain a streams list")
    streams = output.get("streams")
    if not isinstance(streams, list) or not streams:
        raise ProbeError("ffprobe output does not contain a video stream")
    stream = streams[0]
    if not isinstance(stream, dict):
        raise ProbeError("ffprobe returned an invalid video stream")

    dimensions: dict[str, int] = {}
    for name in ("width", "height"):
        value = stream.get(name)
        if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
            raise ProbeError(f"ffprobe returned an invalid {name}")
        dimensions[name] = value

    return VideoInfo(
        relative_path,
        dimensions["width"],
        dimensions["height"],
    )


def sort_by_resolution(
    videos: list[VideoInfo], ascending: bool
) -> list[VideoInfo]:
    def sort_key(video: VideoInfo) -> tuple[int, int, int, str, str]:
        dimensions = (video.width * video.height, video.width, video.height)
        if not ascending:
            dimensions = tuple(-value for value in dimensions)
        return (*dimensions, video.relative_path.casefold(), video.relative_path)

    return sorted(videos, key=sort_key)


def print_table(videos: list[VideoInfo]) -> None:
    resolution_width = max(
        len("Resolution"), *(len(video.resolution) for video in videos)
    )
    print(f"{'Resolution':<{resolution_width}}  File")
    print(f"{'-' * resolution_width}  ----")
    for video in videos:
        print(f"{video.resolution:<{resolution_width}}  {video.relative_path}")


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    if args.ascending and not args.sort_resolution:
        parser.error("--ascending requires --sort-resolution")

    scan_directory = args.directory.expanduser()
    directory = scan_directory.resolve()
    if not directory.is_dir():
        print(
            f"video-resolutions: {directory}: path is not a directory",
            file=sys.stderr,
        )
        return 1

    try:
        candidates = discover_videos(scan_directory, not args.no_recursive)
    except OSError as error:
        print(
            f"video-resolutions: could not scan directory {directory}: {error}",
            file=sys.stderr,
        )
        return 1
    if not candidates:
        print("No videos found.")
        return 0

    ffprobe = shutil.which("ffprobe")
    if ffprobe is None:
        print("video-resolutions: ffprobe was not found on PATH", file=sys.stderr)
        return 1

    videos: list[VideoInfo] = []
    probe_failed = False
    for path, relative_path in candidates:
        try:
            videos.append(probe_video(ffprobe, path, relative_path))
        except ProbeError as error:
            print(
                f"video-resolutions: warning: {relative_path}: {error}",
                file=sys.stderr,
            )
            probe_failed = True

    if args.sort_resolution:
        videos = sort_by_resolution(videos, args.ascending)
    if videos:
        print_table(videos)
    return 1 if probe_failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
